{
  "name": "document-operations-platform",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "next start",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "test:security": "node scripts/sync-clean-install-security.mjs --check && node scripts/security-tests.mjs && node scripts/tracking-tests.mjs && node scripts/public-service-tracking-tests.mjs",
    "security:check": "npm run test:security && npm run test:business && npm run test:checkout && npm run test:accounting && npm run build && npm run audit:production",
    "test:business": "node scripts/business-tests.mjs && node scripts/communications-tests.mjs",
    "test:checkout": "node scripts/checkout-tests.mjs && node scripts/billing-tests.mjs",
    "test:accounting": "node scripts/accounting-tests.mjs && node scripts/print-tests.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jsqr": "1.4.0",
    "next": "16.3.7",
    "pdfjs-dist": "6.3.289",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
