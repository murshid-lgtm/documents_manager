NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use either name below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Slug created in the first-owner bootstrap block. Required for a dedicated install.
NEXT_PUBLIC_ORGANIZATION_SLUG=your-company

# Server-only key required by /api/public/track. Add this in Vercel; NEVER prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Canonical HTTPS deployment URL used for secure staff invitations.
APP_ORIGIN=https://tracker.example.com
# Independent random value used to pseudonymize rate-limit keys.
RATE_LIMIT_PEPPER=replace_with_at_least_32_random_characters

# Optional: customer-facing tracking page base URL. If omitted, the app uses /public-track on the current Vercel domain.
# Example external page: https://www.example.com/track-documents
NEXT_PUBLIC_CUSTOMER_TRACKING_URL=

# Optional automatic WhatsApp Business notifications. Create an approved Meta
# template with four body variables: customer, tracking number, status, link.
# Kept disabled in V4.0. Set true only in a later approved release.
WHATSAPP_AUTOMATION_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=document_case_update
WHATSAPP_TEMPLATE_LANGUAGE=en
# Long random bearer token required by /api/notifications/process.
NOTIFICATION_PROCESS_SECRET=
